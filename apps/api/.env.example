# --- App ---
PORT=3000
WEB_ORIGIN=http://localhost:5173
# production | test | (unset = development). See DEPLOYMENT.md — this flips
# the refresh cookie to secure-only and switches logging to JSON. Leave unset
# for local dev.
# NODE_ENV=production

# --- Database (Phase 1) ---
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_dev

# --- Redis (Phase 1 sessions/perm cache, Phase 5 pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 1) ---
# Access tokens are signed JWTs. Refresh tokens are opaque random values
# (stored hashed, rotated on every use) — not JWTs, so there's no separate
# refresh secret to set.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seed script (apps/api/prisma/seed.ts) ---
# Bootstrap Admin user created by `npm run seed`. Change the password before
# seeding anything but a throwaway local database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
